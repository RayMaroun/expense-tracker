{
  "name": "expense-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Expense tracker: shared library, Express API, and web page.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b",
    "reset": "node -e \"const fs=require('fs');for(const p of ['shared','api','web','legacy-clients']){fs.rmSync('packages/'+p+'/dist',{recursive:true,force:true});fs.rmSync('packages/'+p+'/tsconfig.tsbuildinfo',{force:true});}\" && tsc -b --force",
    "api": "npm run dev --workspace packages/api",
    "web": "npm run dev --workspace packages/web"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
